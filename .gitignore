# Virtual environments
venv/
.venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Model artifacts
*.pt
*.ckpt
*.onnx

# Data — never commit real datasets (keep .gitkeep placeholders)
data/**/*
!data/**/.gitkeep

# Evaluation outputs — track structure, not generated JSON (keep .gitkeep)
results/**/*.json
!results/**/.gitkeep

# anomalib's Engine creates a versioned run workspace, results/<Model>/<Dataset>/
# <category>/vN, on every fit. Our own artifacts go to results/checkpoints/.
results/*/
!results/checkpoints/

# Environment / secrets
.env

# Notebooks
notebooks/.ipynb_checkpoints/

# OS / editor cruft
.DS_Store
