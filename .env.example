# Copy to .env and adjust as needed. All values below are sane defaults.
# Everything under "Model" is read by app/models/config.py (ModelConfig); nothing
# else in the codebase calls os.getenv for these.

# --- Serving / platform -----------------------------------------------------

# Anomaly score threshold above which a pixel/frame is flagged as defective (0.0–1.0)
ANOMALY_THRESHOLD=0.5

# Default MVTec-style object category to run inference against
DEFAULT_CATEGORY=bottle

# Model backend to serve: patchcore | efficientad | winclip
MODEL_BACKEND=patchcore

# Redis connection URL (session manager / result cache)
REDIS_URL=redis://localhost:6379/0

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Port the Prometheus metrics endpoint is exposed on
PROMETHEUS_PORT=9090

# --- Model: backbone & features ---------------------------------------------

# timm backbone used as the frozen patch-feature extractor
MODEL_BACKBONE=wide_resnet50_2

# Comma-separated backbone layers forming the patch embedding. layer2+layer3 are
# abstract enough to describe texture but not so abstract they discard appearance.
MODEL_LAYERS=layer2,layer3

# --- Model: PatchCore memory bank -------------------------------------------

# Fraction of training patch embeddings kept by k-center-greedy coreset sampling.
# Lower = smaller bank and faster inference; 0.01 is the "make CI fast" setting.
CORESET_SAMPLING_RATIO=0.1

# Neighbours consulted when re-weighting the nearest-patch distance
NUM_NEIGHBORS=9

# --- Model: EfficientAD student-teacher --------------------------------------

# Patch Description Network size: small | medium. "small" is the default because
# it converges in reasonable time on one modest GPU; "medium" roughly triples the
# parameter count for a fraction of a point of AUROC.
MODEL_SIZE=small

# ImageNette root. EfficientAD penalises the student for imitating the teacher on
# these out-of-distribution images, which is what stops it generalising to
# defects. Downloaded (~1.5 GB) on the first EfficientAD training run.
IMAGENET_DIR=./data/imagenette

# --- Model: inference --------------------------------------------------------

# Square resolution every image is resized to before inference
IMAGE_SIZE=256

# --- Model: training ---------------------------------------------------------

# Batch size for the train loader (eval reuses it)
TRAIN_BATCH_SIZE=8

# Dataloader worker processes; 0 keeps runs deterministic
NUM_WORKERS=0

# Training epochs. PatchCore is single-pass and pins this to 1; EfficientAD is
# gradient-trained and honours it (the paper's schedule is ~70k steps).
MAX_EPOCHS=1

# Lightning accelerator: auto | cpu | gpu | mps
ACCELERATOR=auto

# Device count. PatchCore's memory bank is single-device only.
DEVICES=1

# Seed for dataset splitting; leave unset for anomalib's default
# SEED=42

# --- Paths -------------------------------------------------------------------

# Dataset root populated by scripts/download_dataset.py
DATA_ROOT=./data/MVTecAD

# Root for run artifacts (logs, metrics)
RESULTS_DIR=./results

# Where trained checkpoints are written, as <model>_<category>.ckpt
CHECKPOINT_DIR=./results/checkpoints
