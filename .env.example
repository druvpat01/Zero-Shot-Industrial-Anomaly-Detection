# Copy to .env and adjust as needed. All values below are sane defaults.
# Everything under "Model" is read by app/models/config.py (ModelConfig); nothing
# else in the codebase calls os.getenv for these.

# --- Access control ----------------------------------------------------------
# Read by app/serving/auth.py. The API key travels in an X-API-Key header;
# membership of one of these lists IS the caller's role.
#
#   viewer   -> POST /predict, GET /health
#   operator -> everything a viewer can do, plus POST /benchmark and GET /models
#
# Both lists are comma-separated. A server with NEITHER set refuses every
# authenticated endpoint with 503 auth_not_configured — this fails closed on
# purpose, so a misspelled variable cannot silently disable access control.
#
# Generate real keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholders below are examples. Replace them, and never commit .env.
#
# In production, replace this with OAuth2/JWT and a proper identity provider;
# .env key storage is portfolio-scope only. See docs/security.md.
VIEWER_API_KEYS=dev-viewer-key
OPERATOR_API_KEYS=dev-operator-key

# Optional pepper mixed into the key hash written to the audit trail. Empty
# means audit identities are comparable across deployments — and reversible for
# a low-entropy key, since anyone holding the file can hash candidates. Set it
# to a secret value to close that.
# API_KEY_HASH_PEPPER=

# Append-only audit trail of every /benchmark call (who, what, how long, what
# they got). Defaults to ./results/audit.jsonl. Point it at a mounted volume in
# a container, or the record dies with the pod.
AUDIT_LOG_PATH=./results/audit.jsonl

# --- Serving / platform -----------------------------------------------------

# Anomaly score threshold above which a pixel/frame is flagged as defective (0.0–1.0)
ANOMALY_THRESHOLD=0.5

# Default MVTec-style object category to run inference against
DEFAULT_CATEGORY=bottle

# Model backend to serve: patchcore | efficientad | winclip
MODEL_BACKEND=patchcore

# Redis connection URL (session manager / result cache)
REDIS_URL=redis://localhost:6379/0

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Port the Prometheus metrics endpoint is exposed on
PROMETHEUS_PORT=9090

# Ceiling on the decoded size of an image submitted to POST /predict, in bytes.
# Checked before the frame is handed to OpenCV, which allocates the full
# decompressed raster — a decompression bomb is exactly a payload that does not
# stay small. 25 MB fits an uncompressed 4096x4096 RGB frame with room to spare.
MAX_IMAGE_BYTES=26214400

# --- Model: backbone & features ---------------------------------------------

# timm backbone used as the frozen patch-feature extractor
MODEL_BACKBONE=wide_resnet50_2

# Comma-separated backbone layers forming the patch embedding. layer2+layer3 are
# abstract enough to describe texture but not so abstract they discard appearance.
MODEL_LAYERS=layer2,layer3

# --- Model: PatchCore memory bank -------------------------------------------

# Fraction of training patch embeddings kept by k-center-greedy coreset sampling.
# Lower = smaller bank and faster inference; 0.01 is the "make CI fast" setting.
CORESET_SAMPLING_RATIO=0.1

# Neighbours consulted when re-weighting the nearest-patch distance
NUM_NEIGHBORS=9

# --- Model: EfficientAD student-teacher --------------------------------------

# Patch Description Network size: small | medium. "small" is the default because
# it converges in reasonable time on one modest GPU; "medium" roughly triples the
# parameter count for a fraction of a point of AUROC.
MODEL_SIZE=small

# ImageNette root. EfficientAD penalises the student for imitating the teacher on
# these out-of-distribution images, which is what stops it generalising to
# defects. Downloaded (~1.5 GB) on the first EfficientAD training run.
IMAGENET_DIR=./data/imagenette

# --- Model: WinCLIP zero-shot ------------------------------------------------

# Noun WinCLIP puts in its text prompts ("a photo of a bottle without defect").
# Leave unset to derive it from DEFAULT_CATEGORY, with underscores turned into
# spaces — CLIP's text encoder was trained on prose, so "metal nut" embeds where
# an actual metal nut does and "metal_nut" does not.
# WINCLIP_CLASS_NAME=bottle

# Normal reference images WinCLIP may consult in addition to the prompts.
# 0 is pure zero-shot and the project's headline configuration: no training
# images at all. 1-4 recovers much of the accuracy gap to PatchCore without
# anything resembling training.
K_SHOT=0

# Comma-separated sliding-window edge lengths, in ViT patches, over WinCLIP's
# 15x15 grid. (2,3) is the paper's setting: 32x32 and 48x48 pixel windows.
WINCLIP_SCALES=2,3

# --- Input-quality guardrails ------------------------------------------------
# Read by app/guardrails (FrameGuard), which gates every frame before a model
# scores it. These catch camera glitches, dirty lenses and lighting failures
# that would otherwise be turned into plausible-looking anomaly scores.

# Reject a frame when its Laplacian variance (focus measure) is below this.
# Measured at a fixed working resolution (see BLUR_RESIZE_EDGE) so the threshold
# is portable across camera resolutions.
BLUR_THRESHOLD=50.0

# Reject when either side is below this many pixels (thumbnail / truncated read).
MIN_RESOLUTION=64

# Reject when width/height is above this or below its reciprocal (a transposed
# buffer or single-row read).
MAX_ASPECT_RATIO=10.0

# A pixel at/below EXPOSURE_DARK_LEVEL is floor-clipped; at/above
# EXPOSURE_BRIGHT_LEVEL is ceiling-clipped. Reject when more than
# EXPOSURE_FRACTION of pixels are clipped (a dead camera or a blown-out light).
EXPOSURE_DARK_LEVEL=10
EXPOSURE_BRIGHT_LEVEL=245
EXPOSURE_FRACTION=0.95

# Longest edge (px) the frame is downscaled to before the blur measure is taken.
# Laplacian variance is resolution-dependent, so pinning the measurement scale is
# what lets BLUR_THRESHOLD have a single portable default.
BLUR_RESIZE_EDGE=256

# --- Model: inference --------------------------------------------------------

# Square resolution every image is resized to before inference. WinCLIP ignores
# this and pins itself to 240: its ViT-B-16-plus-240 backbone has a fixed input
# size, and the wrapper absorbs the difference so callers need not care.
IMAGE_SIZE=256

# --- Model: training ---------------------------------------------------------

# Batch size for the train loader (eval reuses it)
TRAIN_BATCH_SIZE=8

# Dataloader worker processes; 0 keeps runs deterministic
NUM_WORKERS=0

# Training epochs. PatchCore is single-pass and pins this to 1; EfficientAD is
# gradient-trained and honours it (the paper's schedule is ~70k steps).
MAX_EPOCHS=1

# Lightning accelerator: auto | cpu | gpu | mps
ACCELERATOR=auto

# Device count. PatchCore's memory bank is single-device only.
DEVICES=1

# Seed for dataset splitting; leave unset for anomalib's default
# SEED=42

# --- Paths -------------------------------------------------------------------

# Dataset root populated by scripts/download_dataset.py
DATA_ROOT=./data/MVTecAD

# Root for run artifacts (logs, metrics)
RESULTS_DIR=./results

# Where trained checkpoints are written, as <model>_<category>.ckpt
CHECKPOINT_DIR=./results/checkpoints
